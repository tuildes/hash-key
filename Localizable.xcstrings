    "onboarding.description1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstellen Sie sofort starke, zufällige Passwörter mit sicheren Generierungsmethoden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Create strong, random passwords instantly using secure generation methods."
          }
        },
        "en-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Create strong, random passwords instantly using secure generation methods."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea contraseñas fuertes y aleatorias al instante usando métodos de generación seguros."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Créez instantanément des mots de passe forts et aléatoires grâce à des méthodes de génération sécurisées."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buat kata sandi yang kuat dan acak secara instan menggunakan metode pembuatan yang aman."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安全な生成方法を使用して、強力でランダムなパスワードを即座に作成します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crie senhas fortes e aleatórias instantaneamente usando métodos de geração seguros."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crie palavras-passe fortes e aleatórias instantaneamente usando métodos de geração seguros."
          }
        }
      }
    },
    "onboarding.description2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entdecken Sie sofort, wie widerstandsfähig Ihr Passwort gegen Brute-Force-Angriffe ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instantly discover how resilient your password is against brute-force attacks."
          }
        },
        "en-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instantly discover how resilient your password is against brute-force attacks."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descubre instantáneamente qué tan resistente es tu contraseña contra los ataques de fuerza bruta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Découvrez instantanément la résistance de votre mot de passe face aux attaques par force brute."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temukan seketika seberapa tahan kata sandi Anda terhadap serangan brute-force."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パスワードがブルートフォース攻撃に対してどれほど強固かを即座に確認します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descubra instantaneamente o quão resistente é a sua senha contra ataques de força bruta."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descubra instantaneamente o quão resistente é a sua palavra-passe contra ataques de força bruta."
          }
        }
      }
    },
    "onboarding.description3" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sehen Sie die zugrunde liegende Darstellung Ihrer Passwörter mit Standardalgorithmen wie MD5 und SHA."
          }
        },
        "en" : {
          "stringUnit" : {
